# Copie para o Easypanel (aba Ambiente do app). Nunca faça commit de valores reais.

# sugestao | automatico | desligado
MODO=sugestao

# Chave da API da Anthropic (console.anthropic.com), cobrada por uso.
ANTHROPIC_API_KEY=

# Chatwoot: use o endereço interno do Easypanel (mesmo servidor) ou o público.
CHATWOOT_URL=http://ensinoplus_chatwoot:3000
CHATWOOT_ACCOUNT_ID=1
# Token de acesso de um agente do Chatwoot (Perfil > Token de acesso). Crie um agente "Atendente virtual".
CHATWOOT_API_TOKEN=
# Ids das caixas atendidas, separados por vírgula. 11 = Waha.
CHATWOOT_INBOX_IDS=11

# Texto longo e aleatório. Vai no fim da URL do webhook cadastrada no Chatwoot.
WEBHOOK_SEGREDO=

# Id do agente "Almir Sousa" no Chatwoot. Preenchido: ao transferir, a conversa é atribuída a ele.
ATENDENTE_HUMANO_ID=

# Opcionais
# MENSAGEM_TRANSFERENCIA=Para te dar uma resposta com total segurança, vou transferir seu atendimento para o atendente Almir Sousa. Só um instante, por favor.
# CLAUDE_MODELO=claude-opus-5-5
# CLAUDE_ESFORCO=low
# ESPERA_SEGUNDOS=20
# MAX_RESPOSTAS_POR_HORA=8
# HISTORICO_MAX_MENSAGENS=40
# LOG_LEVEL=INFO
